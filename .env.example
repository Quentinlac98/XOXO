# --- Sécurité (OBLIGATOIRE : change ces valeurs !) ---
SECRET_KEY=change-moi-clé-flask-aléatoire
ADMIN_PASSWORD=ChuckBassGodMode2026
BLAIR_SECRET_CODE=24042024
BLAIR_VIP_TOKEN=change-moi-token-blair-unique

# --- Serveur ---
APP_HOST=0.0.0.0
APP_PORT=7777
DEBUG=false

# --- Jeu ---
QUESTIONS_PER_SESSION=10
PHASE2_DURATION_MINUTES=15
